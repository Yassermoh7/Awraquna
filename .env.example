# Public URL of this site (used for canonical URLs, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://awraquna.com

# --- Data source -------------------------------------------------------------
# "sample" (default): bundled catalogue; order requests and leads are written to ./data/*.jsonl
# "odoo": live products from Odoo; order requests become draft quotations, forms become CRM leads
COMMERCE_SOURCE=sample

# Odoo 15 external API (only needed when COMMERCE_SOURCE=odoo)
# Create an API key in Odoo: avatar → Preferences → Account Security → New API Key.
# Use a dedicated user with Sales + CRM rights only.
# Once awraquna.com points at this site, Odoo must live on its own host (e.g. erp.awraquna.com).
ODOO_URL=https://erp.awraquna.com
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=
# Website categories that are industries rather than product types (Restaurants, Retail, Logistics, Healthcare)
ODOO_INDUSTRY_CATEGORY_IDS=26,27,30,31
# Optional: route website requests to specific sales teams
ODOO_SALES_TEAM_ID=
ODOO_LEGAL_TEAM_ID=
ODOO_ARABIC_LANG=ar_001
NEXT_PUBLIC_ODOO_PORTAL_URL=https://erp.awraquna.com/my

# --- Legal Services site ------------------------------------------------------
# Serve the legal site on its own host. Requests to this host are mapped onto /legal.
LEGAL_HOST=legal.awraquna.com
# Absolute base URL used for links to the legal site (leave empty to use /legal on this host)
NEXT_PUBLIC_LEGAL_URL=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_LEGAL_PHONE=
NEXT_PUBLIC_LEGAL_WHATSAPP=
